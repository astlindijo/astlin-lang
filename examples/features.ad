import "lib/geometry.ad" as geometry
import "std/math.ad" as math
import "std/text.ad" as text

struct Report {
    title: str
    origin: geometry.Point
    scores: list[int]
}

fn main() {
    let origin = geometry.Point(0.0, 0.0)
    let target = geometry.Point(3.0, 4.0)
    print("distance:", geometry.distance(origin, target))
    print("square:", math.square(12), "factorial:", math.factorial(10))

    var values = [10, 20]
    values = append(values, 30)
    let changed = updated(values, 0, 99)
    print("original:", values, "changed:", changed)
    print("slice:", slice(changed, 1, 3))
    print(Report("Astlin 0.3", origin, values))

    let words = split(trim("  hello,Astlin,🌍  "), ",")
    print(join(words, " "))
    print("Unicode index:", "café🌍"[4])
    print(text.repeat("ad ", 3))
    print("program arguments:", args())
    assert(contains("Astlin.ad", ".ad"))
}
