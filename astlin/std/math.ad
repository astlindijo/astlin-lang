# Small reusable functions written in Astlin itself.
fn square(value: int) -> int {
    return value * value
}

fn clamp(value: int, lower: int, upper: int) -> int {
    assert(lower <= upper)
    return min(max(value, lower), upper)
}

fn factorial(n: int) -> int {
    assert(n >= 0)
    var result = 1
    for value in range(2, n + 1) {
        result = result * value
    }
    return result
}
