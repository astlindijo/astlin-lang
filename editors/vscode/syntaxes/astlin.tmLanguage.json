{
  "scopeName": "source.astlin",
  "patterns": [
    { "name": "comment.line.number-sign.astlin", "match": "#.*$" },
    { "name": "string.quoted.double.astlin", "begin": "\"", "end": "\"", "patterns": [
      { "name": "constant.character.escape.astlin", "match": "\\\\(?:u[0-9a-fA-F]{4}|.)" }
    ] },
    { "name": "keyword.control.astlin", "match": "\\b(fn|let|var|if|else|while|for|in|return|break|continue|import|as|struct|and|or|not)\\b" },
    { "name": "constant.language.astlin", "match": "\\b(true|false)\\b" },
    { "name": "storage.type.astlin", "match": "\\b(int|float|bool|str|void|list)\\b" },
    { "name": "constant.numeric.astlin", "match": "\\b[0-9]+(?:\\.[0-9]*)?(?:[eE][+-]?[0-9]+)?\\b" },
    { "name": "entity.name.function.astlin", "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()" }
  ]
}
